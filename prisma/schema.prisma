// Shiply Core database. Money columns are integers in piastres and end in "Piasters".
// Times are stored in UTC.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ---------- Accounts ----------

enum Language {
  en
  ar
}

enum UserStatus {
  active
  disabled
}

enum StaffRoleName {
  admin
  operations
  finance
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  email         String?    @unique
  mobile        String?    @unique
  name          String
  passwordHash  String
  language      Language   @default(ar)
  status        UserStatus @default(active)
  failedSignIns Int        @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  sessions    Session[]
  staffRoles  StaffRole[]
  memberships MerchantMember[]
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// Recent sign-in attempts per network address, for the per-address limit.
// The address is stored only as a keyed hash; rows older than the window are pruned.
model SignInAttempt {
  id          String   @id @default(uuid()) @db.Uuid
  addressHash String
  at          DateTime @default(now())

  @@index([addressHash, at])
}

model StaffRole {
  userId String        @db.Uuid
  role   StaffRoleName

  user User @relation(fields: [userId], references: [id])

  @@id([userId, role])
}

// ---------- Merchants ----------

enum MerchantStatus {
  active
  suspended
}

enum CashOutSchedule {
  weekly
  twice_weekly
  daily
}

enum MemberAccess {
  full
  orders_pickups
  finance
}

enum MemberStatus {
  invited
  active
  removed
}

enum BankAccountStatus {
  pending
  active
  replaced
}

model Merchant {
  id              String          @id @default(uuid()) @db.Uuid
  nameEn          String
  nameAr          String
  industry        String?
  website         String?
  logoUrl         String?
  status          MerchantStatus  @default(active)
  cashOutSchedule CashOutSchedule @default(twice_weekly)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  members         MerchantMember[]
  pickupLocations PickupLocation[]
  bankAccounts    BankAccount[]
  priceLists      PriceList[]
  customers       Customer[]
  products        Product[]
  orders          Order[]
  bulkUploads     BulkUpload[]
  pickups         Pickup[]
}

model MerchantMember {
  id         String       @id @default(uuid()) @db.Uuid
  merchantId String       @db.Uuid
  userId     String       @db.Uuid
  access     MemberAccess
  status     MemberStatus @default(active)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([merchantId, userId])
  @@index([userId])
}

model PickupLocation {
  id          String   @id @default(uuid()) @db.Uuid
  merchantId  String   @db.Uuid
  label       String
  addressText String
  areaId        String?  @db.Uuid
  contactName   String   @default("")
  contactMobile String   @default("")
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  merchant     Merchant @relation(fields: [merchantId], references: [id])
  area         Area?    @relation(fields: [areaId], references: [id])
  returnOrders Order[]
  pickups      Pickup[]

  @@index([merchantId])
  @@index([areaId])
}

model BankAccount {
  id            String            @id @default(uuid()) @db.Uuid
  merchantId    String            @db.Uuid
  bankName      String
  holderName    String
  ibanLast4     String
  ibanEncrypted String
  status        BankAccountStatus @default(pending)
  requestedBy   String            @db.Uuid
  approvedBy    String?           @db.Uuid
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId, status])
}

// ---------- Places ----------

model Governorate {
  code   String @id
  nameEn String
  nameAr String

  areas Area[]
}

// A pricing zone decides only the price (Cairo and Giza are one zone).
// Operations always work by Area, never by pricing zone.
model PricingZone {
  code      String @id
  nameEn    String
  nameAr    String
  sortOrder Int

  areas      Area[]
  priceLines PriceListLine[]
}

// A district or city: the unit operations sort, route and report by.
model Area {
  id              String   @id @default(uuid()) @db.Uuid
  governorateCode String
  zoneCode        String
  nameEn          String
  nameAr          String
  // Normalized Arabic and English names for search (see normalizeForSearch).
  searchKey       String
  isServed        Boolean  @default(true)
  createdAt       DateTime @default(now())

  governorate     Governorate      @relation(fields: [governorateCode], references: [code])
  zone            PricingZone      @relation(fields: [zoneCode], references: [code])
  pickupLocations PickupLocation[]
  orders          Order[]

  @@unique([governorateCode, nameEn])
  @@index([zoneCode])
}

// ---------- Platform ----------

model Setting {
  key       String
  // "global" or "merchant:<merchant id>"
  scope     String
  valueJson Json
  updatedAt DateTime @updatedAt

  @@id([scope, key])
}

// Append-only: a database trigger rejects UPDATE and DELETE.
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String
  beforeJson  Json?
  afterJson   Json?
  at          DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
}

model IdempotencyKey {
  scope      String
  key        String
  resultJson Json?
  createdAt  DateTime @default(now())

  @@id([scope, key])
}

// ---------- Prices ----------

enum PackageSize {
  small
  medium
  large
  light_bulky
  heavy_bulky
}

enum OrderType {
  deliver
  pick_and_choose
  exchange
  return
  sign_and_return
  cash_collection
}

enum PriceListStatus {
  pending
  active
  retired
  replaced
}

// A versioned set of prices. merchantId null = the default list for every merchant.
// A list takes effect only when a second person at Shiply approves it.
model PriceList {
  id          String          @id @default(uuid()) @db.Uuid
  merchantId  String?         @db.Uuid
  version     Int
  status      PriceListStatus @default(pending)
  requestedBy String          @db.Uuid
  approvedBy  String?         @db.Uuid
  activatedAt DateTime?
  createdAt   DateTime        @default(now())

  merchant Merchant?        @relation(fields: [merchantId], references: [id])
  lines    PriceListLine[]
  active   ActivePriceList?

  @@index([merchantId, status])
}

model PriceListLine {
  priceListId      String      @db.Uuid
  zoneCode         String
  size             PackageSize
  orderType        OrderType
  shippingPiasters Int

  priceList PriceList   @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  zone      PricingZone @relation(fields: [zoneCode], references: [code])

  @@id([priceListId, zoneCode, size, orderType])
}

// Which list is in force for each scope ("default" or a merchant id).
// The primary key guarantees one active list per scope.
model ActivePriceList {
  scope       String   @id
  priceListId String   @unique @db.Uuid
  updatedAt   DateTime @updatedAt

  priceList PriceList @relation(fields: [priceListId], references: [id])
}

// ---------- Orders ----------

enum OrderStatus {
  new
  pickup_requested
  picked_up
  in_progress
  out_for_delivery
  attempt_failed
  awaiting_merchant_action
  rescheduled
  delivered
  returning
  returned
  canceled
}

enum CashDirection {
  collect
  give
}

enum LabelFormat {
  a6
  a4
}

// A merchant's customer, found again by mobile for the returning-customer offer.
model Customer {
  id              String   @id @default(uuid()) @db.Uuid
  merchantId      String   @db.Uuid
  mobile          String
  name            String
  lastAddressText String
  lastAreaId      String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id])
  orders   Order[]

  @@unique([merchantId, mobile])
}

// The merchant's catalogue, used to pick items for Pick & Choose orders.
model Product {
  id            String   @id @default(uuid()) @db.Uuid
  merchantId    String   @db.Uuid
  nameEn        String
  nameAr        String
  pricePiasters Int
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  merchant Merchant    @relation(fields: [merchantId], references: [id])
  items    OrderItem[]

  @@index([merchantId, isActive])
}

// Fees are frozen at creation and never recalculated.
model Order {
  id                   String         @id @default(uuid()) @db.Uuid
  number               String         @unique
  merchantId           String         @db.Uuid
  type                 OrderType
  status               OrderStatus    @default(new)
  customerId           String         @db.Uuid
  customerName         String
  customerMobile       String
  addressText          String
  addressExtra         String?
  areaId               String         @db.Uuid
  size                 PackageSize
  description          String?
  codAmountPiasters    Int            @default(0)
  refundPiasters       Int            @default(0)
  cashDirection        CashDirection?
  allowOpenPackage     Boolean        @default(false)
  depositRequired      Boolean        @default(false)
  insuredValuePiasters Int            @default(0)
  shippingPiasters     Int
  openPackagePiasters  Int            @default(0)
  codFeePiasters       Int            @default(0)
  insurancePiasters    Int            @default(0)
  vatPiasters          Int
  totalFeePiasters     Int
  merchantReference    String?
  courierNote          String?
  returnLocationId     String?        @db.Uuid
  attempts             Int            @default(0)
  expectedDeliveryDate DateTime?      @db.Date
  createdBy            String         @db.Uuid
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  merchant       Merchant        @relation(fields: [merchantId], references: [id])
  customer       Customer        @relation(fields: [customerId], references: [id])
  area           Area            @relation(fields: [areaId], references: [id])
  returnLocation PickupLocation? @relation(fields: [returnLocationId], references: [id])
  items          OrderItem[]
  events         OrderEvent[]
  labelPrints    LabelPrint[]
  pickupOrder    PickupOrder?
  linksFrom      OrderLink[]     @relation("linkFrom")
  linksTo        OrderLink[]     @relation("linkTo")

  @@index([merchantId, status, createdAt])
  @@index([merchantId, createdAt])
  @@index([merchantId, updatedAt])
  @@index([merchantId, customerMobile])
  @@index([areaId])
  @@index([customerId])
}

model OrderItem {
  id            String  @id @default(uuid()) @db.Uuid
  orderId       String  @db.Uuid
  productId     String? @db.Uuid
  nameEn        String
  nameAr        String
  quantity      Int     @default(1)
  pricePiasters Int     @default(0)

  order   Order    @relation(fields: [orderId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
}

// Exchange and return orders point at the original order.
model OrderLink {
  fromOrderId String   @db.Uuid
  toOrderId   String   @db.Uuid
  kind        String
  createdAt   DateTime @default(now())

  fromOrder Order @relation("linkFrom", fields: [fromOrderId], references: [id])
  toOrder   Order @relation("linkTo", fields: [toOrderId], references: [id])

  @@id([fromOrderId, toOrderId])
}

// Append-only timeline (a database trigger rejects UPDATE and DELETE).
model OrderEvent {
  id          String       @id @default(uuid()) @db.Uuid
  orderId     String       @db.Uuid
  kind        String
  fromStatus  OrderStatus?
  toStatus    OrderStatus?
  reason      String?
  note        String?
  actorUserId String?      @db.Uuid
  at          DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId, at])
}

model LabelPrint {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @db.Uuid
  format    LabelFormat
  printedBy String      @db.Uuid
  printedAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model BulkUpload {
  id           String   @id @default(uuid()) @db.Uuid
  merchantId   String   @db.Uuid
  fileName     String
  fileHash     String
  rowCount     Int
  createdCount Int
  failedCount  Int
  resultJson   Json
  uploadedBy   String   @db.Uuid
  createdAt    DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId, createdAt])
}

// A user's saved Orders filters ("views"), kept as the page's query string.
model SavedView {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  merchantId String  @db.Uuid
  name      String
  query     String
  createdAt DateTime @default(now())

  @@index([userId, merchantId])
}

// ---------- Pickups ----------

enum PickupStatus {
  scheduled
  collected
  canceled
}

// A courier visit to collect a merchant's ready orders. Address and contact are
// snapshots, so editing the location later does not change a booked pickup.
model Pickup {
  id             String       @id @default(uuid()) @db.Uuid
  number         String       @unique
  merchantId     String       @db.Uuid
  locationId     String       @db.Uuid
  addressText    String
  areaId         String?      @db.Uuid
  contactName    String
  contactMobile  String
  pickupDate     DateTime     @db.Date
  expectedCount  Int
  status         PickupStatus @default(scheduled)
  repeatWeekly   Boolean      @default(false)
  seriesId       String?      @db.Uuid
  collectedCount Int?
  rating         Int?
  ratingComment  String?
  createdBy      String       @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  merchant Merchant       @relation(fields: [merchantId], references: [id])
  location PickupLocation @relation(fields: [locationId], references: [id])
  orders   PickupOrder[]

  @@index([merchantId, status, pickupDate])
  @@index([locationId, pickupDate])
  @@index([pickupDate, status])
}

// Which orders a pickup is meant to collect; an order is in at most one pickup.
model PickupOrder {
  pickupId String @db.Uuid
  orderId  String @unique @db.Uuid

  pickup Pickup @relation(fields: [pickupId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  @@id([pickupId, orderId])
}

// ---------- Money ----------
// Double-entry ledger. Balances are always summed from lines; nothing stores a balance.
// Database triggers make entries and lines append-only and reject unbalanced entries.

model LedgerAccount {
  code      String   @id
  kind      String
  createdAt DateTime @default(now())

  lines LedgerLine[]
}

model LedgerEntry {
  id             String   @id @default(uuid()) @db.Uuid
  idempotencyKey String   @unique
  reason         String
  orderId        String?  @db.Uuid
  cashOutId      String?  @db.Uuid
  merchantId     String?  @db.Uuid
  postedAt       DateTime @default(now())

  lines LedgerLine[]

  @@index([merchantId, postedAt])
  @@index([orderId])
}

model LedgerLine {
  id             String @id @default(uuid()) @db.Uuid
  entryId        String @db.Uuid
  accountCode    String
  // Positive = debit, negative = credit. Every entry's lines sum to zero.
  amountPiasters Int

  entry   LedgerEntry   @relation(fields: [entryId], references: [id])
  account LedgerAccount @relation(fields: [accountCode], references: [code])

  @@index([accountCode])
  @@index([entryId])
}

enum CashOutStatus {
  prepared
  approved
  paid
  canceled
}

// One per merchant per Cairo day: the day's order bookings, closed at 23:59 Cairo.
// Totals are copied from the ledger at close; the ledger stays the source of truth.
model CashCycle {
  id                    String    @id @default(uuid()) @db.Uuid
  merchantId            String    @db.Uuid
  cycleDate             DateTime  @db.Date
  cashCollectedPiasters Int
  feesPiasters          Int
  netPiasters           Int
  orderCount            Int
  closedAt              DateTime  @default(now())
  cashOutId             String?   @db.Uuid

  cashOut CashOut?         @relation(fields: [cashOutId], references: [id])
  entries CashCycleEntry[]

  @@unique([merchantId, cycleDate])
  @@index([cashOutId])
}

// Which ledger entries a cycle covers (entries themselves are append-only).
model CashCycleEntry {
  cycleId String @db.Uuid
  entryId String @unique @db.Uuid

  cycle CashCycle @relation(fields: [cycleId], references: [id])

  @@id([cycleId, entryId])
}

// A payout to the merchant's bank: prepared by finance, approved by a second person, then paid.
model CashOut {
  id               String        @id @default(uuid()) @db.Uuid
  number           String        @unique
  merchantId       String        @db.Uuid
  bankAccountId    String        @db.Uuid
  amountPiasters   Int
  scheduledDate    DateTime      @db.Date
  status           CashOutStatus @default(prepared)
  preparedBy       String        @db.Uuid
  approvedBy       String?       @db.Uuid
  paidBy           String?       @db.Uuid
  bankReference    String?
  receiptPath      String?
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  cycles CashCycle[]

  @@index([merchantId, status])
  @@index([status, scheduledDate])
}

// ---------- Support ----------

enum SupportTopic {
  order
  pickup
  payment
  account
  other
}

enum SupportTicketStatus {
  open
  answered
  closed
}

enum SupportAuthorKind {
  merchant
  staff
}

model SupportTicket {
  id          String              @id @default(uuid()) @db.Uuid
  number      String              @unique
  merchantId  String              @db.Uuid
  createdBy   String              @db.Uuid
  topic       SupportTopic
  orderNumber String?
  subject     String
  status      SupportTicketStatus @default(open)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  messages SupportMessage[]

  @@index([merchantId, status, updatedAt])
  @@index([status, updatedAt])
}

model SupportMessage {
  id           String            @id @default(uuid()) @db.Uuid
  ticketId     String            @db.Uuid
  authorUserId String            @db.Uuid
  authorKind   SupportAuthorKind
  body         String
  createdAt    DateTime          @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id])

  @@index([ticketId, createdAt])
}
