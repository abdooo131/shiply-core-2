// Shiply Core database. Money columns are integers in piastres and end in "Piasters".
// Times are stored in UTC.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ---------- Accounts ----------

enum Language {
  en
  ar
}

enum UserStatus {
  active
  disabled
}

enum StaffRoleName {
  admin
  operations
  finance
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  email         String?    @unique
  mobile        String?    @unique
  name          String
  passwordHash  String
  language      Language   @default(ar)
  status        UserStatus @default(active)
  failedSignIns Int        @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  sessions    Session[]
  staffRoles  StaffRole[]
  memberships MerchantMember[]
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// Recent sign-in attempts per network address, for the per-address limit.
// The address is stored only as a keyed hash; rows older than the window are pruned.
model SignInAttempt {
  id          String   @id @default(uuid()) @db.Uuid
  addressHash String
  at          DateTime @default(now())

  @@index([addressHash, at])
}

model StaffRole {
  userId String        @db.Uuid
  role   StaffRoleName

  user User @relation(fields: [userId], references: [id])

  @@id([userId, role])
}

// ---------- Merchants ----------

enum MerchantStatus {
  active
  suspended
}

enum CashOutSchedule {
  weekly
  twice_weekly
  daily
}

enum MemberAccess {
  full
  orders_pickups
  finance
}

enum MemberStatus {
  invited
  active
  removed
}

enum BankAccountStatus {
  pending
  active
  replaced
}

model Merchant {
  id              String          @id @default(uuid()) @db.Uuid
  nameEn          String
  nameAr          String
  industry        String?
  website         String?
  logoUrl         String?
  status          MerchantStatus  @default(active)
  cashOutSchedule CashOutSchedule @default(twice_weekly)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  members         MerchantMember[]
  pickupLocations PickupLocation[]
  bankAccounts    BankAccount[]
}

model MerchantMember {
  id         String       @id @default(uuid()) @db.Uuid
  merchantId String       @db.Uuid
  userId     String       @db.Uuid
  access     MemberAccess
  status     MemberStatus @default(active)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([merchantId, userId])
  @@index([userId])
}

model PickupLocation {
  id          String   @id @default(uuid()) @db.Uuid
  merchantId  String   @db.Uuid
  label       String
  addressText String
  areaId      String?  @db.Uuid
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id])
  area     Area?    @relation(fields: [areaId], references: [id])

  @@index([merchantId])
  @@index([areaId])
}

model BankAccount {
  id            String            @id @default(uuid()) @db.Uuid
  merchantId    String            @db.Uuid
  bankName      String
  holderName    String
  ibanLast4     String
  ibanEncrypted String
  status        BankAccountStatus @default(pending)
  requestedBy   String            @db.Uuid
  approvedBy    String?           @db.Uuid
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId, status])
}

// ---------- Places ----------

model Governorate {
  code   String @id
  nameEn String
  nameAr String

  areas Area[]
}

// A pricing zone decides only the price (Cairo and Giza are one zone).
// Operations always work by Area, never by pricing zone.
model PricingZone {
  code      String @id
  nameEn    String
  nameAr    String
  sortOrder Int

  areas Area[]
}

// A district or city: the unit operations sort, route and report by.
model Area {
  id              String   @id @default(uuid()) @db.Uuid
  governorateCode String
  zoneCode        String
  nameEn          String
  nameAr          String
  // Normalized Arabic and English names for search (see normalizeForSearch).
  searchKey       String
  isServed        Boolean  @default(true)
  createdAt       DateTime @default(now())

  governorate     Governorate      @relation(fields: [governorateCode], references: [code])
  zone            PricingZone      @relation(fields: [zoneCode], references: [code])
  pickupLocations PickupLocation[]

  @@unique([governorateCode, nameEn])
  @@index([zoneCode])
}

// ---------- Platform ----------

model Setting {
  key       String
  // "global" or "merchant:<merchant id>"
  scope     String
  valueJson Json
  updatedAt DateTime @updatedAt

  @@id([scope, key])
}

// Append-only: a database trigger rejects UPDATE and DELETE.
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String
  beforeJson  Json?
  afterJson   Json?
  at          DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
}

model IdempotencyKey {
  scope      String
  key        String
  resultJson Json?
  createdAt  DateTime @default(now())

  @@id([scope, key])
}
